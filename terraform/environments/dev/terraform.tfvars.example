# ============================================================================
# Przykładowy plik zmiennych – skopiuj do terraform.tfvars i uzupełnij
# UWAGA: terraform.tfvars jest w .gitignore – nie commituj!
# ============================================================================

# Project ID – ustawiany automatycznie jeśli użyjesz create-project.sh
# Można też ustawić ręcznie:
project_id          = "reinventor-ai-gateway-poc-xxxx"
region              = "europe-central2"
zone                = "europe-central2-a"
terraform_sa_email  = "ai-gateway-terraform@reinventor-ai-gateway-poc-xxxx.iam.gserviceaccount.com"

# Opcjonalne – domyślne wartości zwykle wystarczą dla PoC
# network_name  = "ai-gateway-vpc"
# cluster_name  = "ai-gateway-cluster"
# machine_type  = "e2-standard-2"
# node_count    = 1
